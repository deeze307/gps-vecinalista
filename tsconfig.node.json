{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,

    // Explícito a propósito: `vite.config.ts` usa `node:url` e `import.meta.url`.
    // Sin esto, TypeScript los resuelve sólo si encuentra un @types/node suelto en
    // algún directorio padre — funciona en una máquina y falla en el CI.
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
